# Banco PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/cortaai"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cortaai"

# Gere um segredo aleatorio de pelo menos 32 caracteres
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_48_BYTES"
FRONTEND_URL="http://localhost:4200"
NODE_ENV="development"
PORT=3000

# Envio de codigos pelo Gmail (credenciais da conta remetente)
GMAIL_CLIENT_ID="SEU_CLIENT_ID.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="SEU_CLIENT_SECRET"
GMAIL_REFRESH_TOKEN="SEU_REFRESH_TOKEN"
GMAIL_USER="remetente@example.com"

# Login com Google (cliente OAuth do tipo Web application)
GOOGLE_CLIENT_ID="SEU_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="SEU_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
